# SafeDrop Environment Configuration

# Google AI / Gemma API Key (Optional if running local open-weights Gemma 4)
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here

# Local Server Port (default: 8000)
PORT=8000
HOST=127.0.0.1

# Processing Mode: 'local' (deterministic only), 'hybrid' (deterministic + Gemma)
PROCESSING_MODE=hybrid

# Redaction Default: 'blackout', 'blur', 'pixelate'
DEFAULT_REDACTION_STYLE=blackout

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
